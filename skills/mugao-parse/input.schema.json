{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MugaoParseInput",
  "type": "object",
  "required": ["title", "rawText"],
  "properties": {
    "title": {
      "type": "string"
    },
    "rawText": {
      "type": "string"
    },
    "targetAudience": {
      "type": "string",
      "default": "ordinary readers"
    },
    "targetPlatforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

